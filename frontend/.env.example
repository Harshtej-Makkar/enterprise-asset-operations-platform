# EAOP Frontend — environment variables (example)
# Copy to .env.local and adjust as needed.

# Base URL for the mock/stub backend REST API.
# In dev, Vite proxies /api to the backend (see vite.config.ts) — so this is left empty.
# In a real deployment this would be the backend's public URL.
VITE_API_BASE_URL=/api

# Absolute origin for uploaded photo assets served by the backend.
# The backend stores images under `/uploads/*` and the API returns
# relative paths (e.g. `/uploads/abc.png`). In dev this defaults to
# http://localhost:4000. In production, set this to your backend's
# public origin (e.g. https://eaop-api.railway.app).
VITE_UPLOADS_BASE_URL=http://localhost:4000
