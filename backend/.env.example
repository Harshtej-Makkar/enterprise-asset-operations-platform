# EAOP Backend — environment variables (example)
# Copy to .env and adjust as needed.

# Server
PORT=4000
NODE_ENV=development

# CORS — the Vite dev server origin
CORS_ORIGIN=http://localhost:5173

# JWT
# IMPORTANT: this secret MUST be replaced in any real deployment.
# The simplified/demo flow is documented in the backend README (FSMOD §16).
JWT_SECRET=change-me-in-production-this-is-a-demo-secret
JWT_EXPIRES_IN=7d

# PostgreSQL
# If unset, the server starts in "no-db" mode and returns seed-derived
# in-memory data, which is enough for the Week 1 demo and keeps the
# contributor story honest (FSMOD §16).
DATABASE_URL=postgres://eaop:eaop@localhost:5432/eaop
